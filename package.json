{
  "name": "@bezel-labs/bezel-kit",
  "version": "0.12.0",
  "type": "module",
  "description": "Convert a W3C Design Tokens (DTCG) file into a scoped variables.css, with one CSS scope per context.",
  "keywords": [
    "design-tokens",
    "agent-skills",
    "dtcg",
    "css-variables",
    "css-custom-properties",
    "theming",
    "style-dictionary"
  ],
  "license": "PolyForm-Shield-1.0.0",
  "author": "Bezel (https://bezel.new/?utm_source=npm&utm_medium=referral&utm_content=bezel-kit-author)",
  "homepage": "https://bezel.new/?utm_source=npm&utm_medium=referral&utm_content=bezel-kit-homepage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bezel-labs/bezel-kit.git"
  },
  "bugs": {
    "url": "https://github.com/bezel-labs/bezel-kit/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./agent-skill": {
      "types": "./dist/agent-skill.d.ts",
      "import": "./dist/agent-skill.js",
      "require": "./dist/agent-skill.cjs"
    }
  },
  "bin": {
    "bezel": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "gen:skill": "node scripts/build-agent-skill.mjs",
    "build": "npm run gen:skill && tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky"
  },
  "dependencies": {
    "@inquirer/select": "^5.2.6",
    "fast-json-patch": "^3.1.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.2.5",
    "tsup": "^9.0.0",
    "typescript": "5.9.3"
  }
}
